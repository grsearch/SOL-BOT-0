# ============ API Keys ============
BIRDEYE_API_KEY=your_birdeye_premium_plus_key
HELIUS_API_KEY=your_helius_business_key
JUPITER_API_KEY=your_jupiter_developer_key
X_BEARER_TOKEN=your_x_api_bearer_token

# ============ Discord ============
# ⚠️ 这是敏感信息，泄露后任何人都能往你的频道发消息
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/xxx

# ============ Webhook 入站鉴权 ============
# 调用 /webhook/add-token 时需要在 header 里带 x-webhook-secret
WEBHOOK_SECRET=change_this_to_a_long_random_string

# ============ 前端 API 鉴权 ============
# 前端访问 /api/* 时需要在 header 里带 x-api-token，否则任何能访问端口的人都能操控钱包。
# 留空 = 关闭鉴权（仅当 HOST=127.0.0.1 且确信无外部访问时可这么做）
# 强烈建议设置为一个长随机字符串
API_TOKEN=change_this_to_another_long_random_string

# ============ 钱包 ============
# 如果留空，启动时会交互式提示输入密码
# 生产环境强烈建议留空，或者通过密钥管理服务（KMS）注入
WALLET_PASSWORD=

# ============ 服务端口 ============
PORT=3001
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173

# ============ 数据库 ============
DATABASE_PATH=./data.db

# ============ 交易策略 ============
DEFAULT_BUY_SOL=1
DEFAULT_SLIPPAGE_BPS=300         # 3% 默认滑点
DEFAULT_PRIORITY_FEE_LAMPORTS=1000000  # 0.001 SOL max priority fee
JITO_TIP_LAMPORTS=100000         # Jito tip，0 表示不用 Jito（不开 MEV protect）

# ============ 报警/止盈 ============
STOP_LOSS_DROP_PCT=50            # 24h 高点回落 50% 报警
STOP_LOSS_COOLDOWN_HOURS=2       # 同一币种报警冷却小时数
TAKE_PROFIT_GAIN_PCT=100         # 涨 100%（2倍）自动止盈

# ============ 监控阈值 ============
FDV_MIN_USD=30000
LP_MIN_USD=10000
MONITOR_CHECK_INTERVAL_MS=300000 # 5 分钟巡检一次 FDV/LP

# ============ X API 预算 ============
X_DAILY_BUDGET_USD=10
X_REFRESH_INTERVAL_MS=900000     # 15 分钟刷新一次
X_FALLBACK_INTERVAL_MS=3600000   # 预算紧张时降级到 60 分钟
X_COST_PER_READ_USD=0.005

# ============ RPC ============
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
